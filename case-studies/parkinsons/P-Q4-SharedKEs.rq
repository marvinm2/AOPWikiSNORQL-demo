#This SPARQL query identifies Key Events shared across multiple Parkinson's-related AOPs
#Reveals convergence points in the pathway network leading to parkinsonian motor deficits
SELECT ?KE ?KETitle (COUNT(DISTINCT ?AOP) AS ?AOPCount) (GROUP_CONCAT(DISTINCT ?AOPTitle; separator=" | ") AS ?AOPs)
WHERE {
  ?AO a aopo:KeyEvent ;
      dc:title ?AOTitle .

  ?AOP a aopo:AdverseOutcomePathway ;
       dc:title ?AOPTitle ;
       aopo:has_adverse_outcome ?AO ;
       aopo:has_key_event ?KE .

  ?KE dc:title ?KETitle .

  FILTER (?AO = aop.events:896)  #Parkinsonian motor deficits
}
GROUP BY ?KE ?KETitle
HAVING (COUNT(DISTINCT ?AOP) > 1)
ORDER BY DESC(?AOPCount) ?KETitle
