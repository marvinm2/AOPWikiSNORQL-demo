#This SPARQL query extracts all Key Event Relationships (KERs) in AOP 464
#Shows the causal connections between upstream and downstream events
SELECT DISTINCT ?KER ?KEup ?KEupTitle ?KEdown ?KEdownTitle
WHERE {
  ?AOP a aopo:AdverseOutcomePathway ;
       aopo:has_key_event_relationship ?KER .

  ?KER aopo:has_upstream_key_event ?KEup ;
       aopo:has_downstream_key_event ?KEdown .

  ?KEup dc:title ?KEupTitle .
  ?KEdown dc:title ?KEdownTitle .

  FILTER (?AOP = aop:464)
}
ORDER BY ?KEup ?KEdown
