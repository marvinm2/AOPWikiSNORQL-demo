#This SPARQL query maps pathways converging to parkinsonian motor deficits (AO 896)
#Shows how different MIEs lead through various KEs to the same adverse outcome
SELECT DISTINCT ?AOP ?AOPTitle ?MIE ?MIETitle ?KER ?KEup ?KEupTitle ?KEdown ?KEdownTitle ?AO ?AOTitle
WHERE {
  ?AO a aopo:KeyEvent ;
      dc:title ?AOTitle .

  ?AOP a aopo:AdverseOutcomePathway ;
       dc:title ?AOPTitle ;
       aopo:has_adverse_outcome ?AO .

  OPTIONAL {
    ?AOP aopo:has_molecular_initiating_event ?MIE .
    ?MIE dc:title ?MIETitle .
  }

  OPTIONAL {
    ?AOP aopo:has_key_event_relationship ?KER .
    ?KER aopo:has_upstream_key_event ?KEup ;
         aopo:has_downstream_key_event ?KEdown .
    ?KEup dc:title ?KEupTitle .
    ?KEdown dc:title ?KEdownTitle .
  }

  FILTER (?AO = aop.events:896)  #Parkinsonian motor deficits
}
ORDER BY ?AOP ?MIE ?KEup ?KEdown
